# AI captions
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Publishing: queue | browser | meta | postiz
PUBLISH_BACKEND=queue

# Meta Graph API backend
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Configurable API version; verify it is available for your Meta app.
META_GRAPH_VERSION=v26.0

# Start with one record per run across all sources.
MAX_PER_RUN=1

# Postiz backend
POSTIZ_BASE_URL=
POSTIZ_API_KEY=

# Browser backend (Playwright login). BROWSER_PLATFORM: x | facebook
BROWSER_PLATFORM=x
X_USERNAME=
X_PASSWORD=
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=

# Optional: path of the SQLite dedupe database
AUTOPOST_DB=autopost.db
