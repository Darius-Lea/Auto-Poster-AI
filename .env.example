# AI captions
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Publishing: queue | browser | meta | postiz
PUBLISH_BACKEND=queue

# Meta Graph API backend
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Configurable API version; verify it is available for your Meta app.
META_GRAPH_VERSION=v26.0

# Start with one record per run across all sources.
MAX_PER_RUN=1
# Include the entire CURRENT jail roster. Positive values restrict booking age.
MAX_AGE_DAYS=0
# New bookings accumulate and post in batches of this size (Meta backend only).
# Set to 0 or leave unset to post bookings one at a time.
BOOKING_BATCH_SIZE=5
# Post a standalone RELEASED announcement when a confirmed booking leaves the roster.
RELEASE_POSTS_ENABLED=true

# Postiz backend
POSTIZ_BASE_URL=
POSTIZ_API_KEY=

# Browser backend (Playwright login). BROWSER_PLATFORM: x | facebook
BROWSER_PLATFORM=x
X_USERNAME=
X_PASSWORD=
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=

# Optional: path of the SQLite dedupe database
AUTOPOST_DB=autopost.db

# Optional managed creative services: operator-only; never requested from customers.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# AUTOPOST_AI_PROVIDERS=openai,anthropic,gemini
# AUTOPOST_CONNECTOR_SECRET=stable-at-least-32-character-server-secret
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
# CANVA_REDIRECT_URI=https://your-app.example/connections/canva/callback

# Public launch stays closed until operator setup and live verification are complete.
# AUTOPOST_PUBLIC_SALES_ENABLED=false
# AUTOPOST_PUBLIC_URL=https://your-app.example
# AUTOPOST_SUPPORT_EMAIL=
# AUTOPOST_OPERATOR_NAME=
# AUTOPOST_LEGAL_REVIEW_VERIFIED=false
# AUTOPOST_DURABLE_STORAGE_VERIFIED=false
# AUTOPOST_RELEASE_VERIFIED=false
# AUTOPOST_SMTP_HOST=
# AUTOPOST_SMTP_PORT=587
# AUTOPOST_SMTP_USER=
# AUTOPOST_SMTP_PASSWORD=
# AUTOPOST_SMTP_FROM=
# AUTOPOST_SMTP_SECURITY=starttls
# STRIPE_CREATOR_PRICE_ID=
# STRIPE_BUSINESS_PRICE_ID=
# STRIPE_AGENCY_PRICE_ID=

# Optional hosted Clip Studio. Requires ffmpeg + requirements-clip.txt, durable
# storage and available CPU. See docs/HOSTED_APP_DEPLOYMENT.md before enabling.
# AUTOPOST_CLIP_ENABLED=false
# AUTOPOST_CLIP_DATA_DIR=/var/lib/autoposter/clip-data
# HF_HOME=/var/lib/autoposter/models
